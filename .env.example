# MIRAEPASS API 주소 (끝에 / 포함)
MIRAEPASS_API_URL=https://miraepass.xyz/api/
# 결제(DEDUCT_POINT) + 환불(GRANT_POINT) 권한을 가진 서비스 계정
MIRAEPASS_SERVICE_ID=5001
MIRAEPASS_SERVICE_PASSWORD=
# 1 이면 MIRAEPASS 대신 인메모리 모의 구현 사용 (개발/테스트용)
MIRAEPASS_MOCK=1

# 관리자 / 직원으로 로그인 가능한 MIRAEPASS 사용자 ID (쉼표 구분). 9001/9002는 mock 계정(비밀번호 admin/staff)
ADMIN_USER_IDS=9001
STAFF_USER_IDS=9002

# 32자 이상 임의 문자열
SESSION_SECRET=change-me-to-a-long-random-string-32chars+
# 키오스크 기기 등록 토큰
KIOSK_DEVICE_TOKEN=kiosk-dev-token

PORT=3000

# HTTPS 없이 운영할 때 1 (로그인 쿠키 secure 해제)
INSECURE_COOKIE=
