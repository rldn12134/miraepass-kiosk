{
  "name": "miraepass-kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "순천미래과학고 교내 카페 키오스크 (MIRAEPASS 결제)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./.next --ignore ./data server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx lib/db/seed.ts"
  },
  "dependencies": {
    "@miraepass/api-client": "0.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-query": "^5.107.1",
    "@types/canvas-confetti": "^1.9.0",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "ofetch": "^1.5.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
